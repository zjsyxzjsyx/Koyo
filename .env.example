# 项目目录的 .env：与 config.toml 同样的设置，写成环境变量；优先于 config.toml，低于进程环境变量。
# 复制为 .env 后只填需要的行；空值等于不设置。.env 已被 .gitignore 忽略，不要提交密钥。
# 数组（目录）用 ; 分隔，扩展名用 , 分隔，布尔值写 1 或 0，budgets 写 JSON。

# [model] 模型端点（OpenAI 风格的 Chat Completions）
# model.base_url：API 根路径，例如 https://api.deepseek.com/v1
ZHIQIU_LLM_BASE_URL=
# model.model：模型名
ZHIQIU_LLM_MODEL=
# model.api_key：必填；也可以只写在 .env 或环境变量里
ZHIQIU_LLM_API_KEY=
# model.choices：输入框模型按钮里可选的模型；不填用端点的模型列表和价格页上的模型
ZHIQIU_LLM_MODELS=
# model.stream：流式输出
ZHIQIU_LLM_STREAM=
# model.window：上下文窗口（token），不填不做超限判断
ZHIQIU_LLM_WINDOW=
# model.output_reserve：输出预留，也是请求的 max_tokens
ZHIQIU_LLM_OUTPUT_RESERVE=
# model.margin：余量
ZHIQIU_LLM_MARGIN=
# model.window_verified：窗口已实测（只记入审计）
ZHIQIU_LLM_WINDOW_VERIFIED=
# model.budgets：按模型配置预算，键为模型名或“端点|模型名”
ZHIQIU_MODEL_BUDGETS=

# [web] 启动：不带参数运行 zhiqiu 与 zhiqiu web 的默认值
# web.port：工作台端口
ZHIQIU_WEB_PORT=
# web.open：启动后打开浏览器
ZHIQIU_WEB_OPEN=
# web.db：数据库文件；留空用 %LOCALAPPDATA%\zhiqiu\state.sqlite
ZHIQIU_DB=
# web.default_command：不带参数运行 zhiqiu 时：web 打开工作台，status 只看状态
ZHIQIU_DEFAULT_COMMAND=

# [learn] 学习
# learn.offline：禁止联网搜索，相当于每次都加 --offline
ZHIQIU_OFFLINE=

# [materials] 学习资料的范围与上限
# materials.max_chars：一次学习的资料合计字数上限
ZHIQIU_MATERIALS_MAX_CHARS=
# materials.max_file_bytes：单个文件的大小上限（字节）
ZHIQIU_MATERIALS_MAX_FILE_BYTES=
# materials.max_files：一个目录最多读多少个文件
ZHIQIU_MATERIALS_MAX_FILES=
# materials.code_files：读代码、配置等文本文件；false 时只读 .md 和 .txt
ZHIQIU_MATERIALS_CODE_FILES=
# materials.extra_suffixes：另外要读的扩展名，例如 [".kt", ".lua"]
ZHIQIU_MATERIALS_EXTRA_SUFFIXES=
# materials.respect_gitignore：扫描目录时跳过 .gitignore 里的文件
ZHIQIU_MATERIALS_RESPECT_GITIGNORE=

# [roots] 对话中可读、可写的目录（与工作台“目录白名单”页添加的合并）
# roots.read：对话中可以直接读取的目录
ZHIQIU_READ_ROOTS=
# roots.write：对话中可以写笔记的目录（每次写入仍要批准）
ZHIQIU_WRITE_ROOTS=
# roots.skills：自己的教学 Skill 目录；留空用 %LOCALAPPDATA%\zhiqiu\skills
ZHIQIU_SKILLS_DIR=

# [voice] 本地语音输入
# voice.auto_download：缺少语音模型时：ask 先问再下载，always 直接下载，never 不下载
ZHIQIU_VOICE_AUTO_DOWNLOAD=
# voice.mirror_url：语音模型的下载地址；留空从 GitHub 下载
ZHIQIU_VOICE_MIRROR_URL=
# voice.model：语音模型目录；留空用 %LOCALAPPDATA%\zhiqiu\voice 下的默认目录
ZHIQIU_VOICE_MODEL=
# voice.language：识别语言
ZHIQIU_VOICE_LANGUAGE=
# voice.threads：识别用的 CPU 线程数，不填为 min(4, CPU 核数)
ZHIQIU_VOICE_THREADS=

# [services] 其他服务
# services.exa_api_key：Exa 联网搜索
ZHIQIU_EXA_API_KEY=
# services.search：联网搜索来源：auto 有 Exa 密钥用 Exa，否则用模型端点自带的搜索（如 DeepSeek，按次计费）；exa、provider 只用其中一个；off 不搜索
ZHIQIU_SEARCH=
# services.notion_token：Notion 内部集成令牌（learn --notion）
ZHIQIU_NOTION_TOKEN=
# services.mcp_config：外部 MCP 工具配置文件
ZHIQIU_MCP_CONFIG=
# services.approval_config：对话审批策略文件
ZHIQIU_APPROVAL_CONFIG=

# [price] 花费统计：每百万 token 的价格（不填只显示 token）
# price.input：输入
ZHIQIU_PRICE_INPUT=
# price.cached_input：缓存命中的输入，不填按输入价
ZHIQIU_PRICE_CACHED_INPUT=
# price.output：输出
ZHIQIU_PRICE_OUTPUT=
# price.currency：金额前缀，例如 ¥ 或 $
ZHIQIU_PRICE_CURRENCY=
# price.models：按模型手填价格，优先于价格页
ZHIQIU_PRICE_MODELS=
# price.auto_update：工作台启动时，若价格超过 7 天未更新，就读一次厂商价格页（一次小的模型调用）
ZHIQIU_PRICE_AUTO_UPDATE=

# [trace] 观测
# trace.content：保存每次模型调用的请求与回复正文（脱敏、截断）
ZHIQIU_TRACE_CONTENT=
