.venv/
.cache/
.pytest_cache/
__pycache__/
*.pyc
*.sqlite
*.sqlite-*
# Migration backups and temporary copies (state.sqlite.pre-v17.bak, *.migrating) hold user data.
*.sqlite.*
.env

# labels/ keeps only the sample inputs; reports, labels and run results stay local.
labels/**
!labels/**/
!labels/samples.json
!labels/*/samples.json
!labels/*/cases.json
# The graded-evaluation record is versioned: `zhiqiu gate` checks it against the prompt fingerprint.
!labels/eval-runs.jsonl
